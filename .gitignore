# nodejs
package-lock.json
.env

# next-sitemap output. Regenerated by the `postbuild` script on every build
# (including inside the Docker image), so committing it only produces diff
# noise — every build rewrites every <lastmod> timestamp.
public/robots.txt
public/sitemap.xml
public/sitemap-0.xml
